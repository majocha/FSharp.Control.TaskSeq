<Project>
    <Import Project="Version.props" />
    <PropertyGroup>
        <RuntimeAsyncBitsPath Condition="'$(RuntimeAsyncBitsPath)' == ''">E:\repos\fsharp\artifacts\bin</RuntimeAsyncBitsPath>
        <DotnetFscCompilerPath>$(RuntimeAsyncBitsPath)\fsc\Release\net11.0\fsc.dll</DotnetFscCompilerPath>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <!-- Runtime-async requires the FSharp.Core built from dotnet/fsharp PR #20235 -->
        <Reference Include="FSharp.Core">
            <HintPath>$(RuntimeAsyncBitsPath)\FSharp.Core\Release\net10.0\FSharp.Core.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
</Project>